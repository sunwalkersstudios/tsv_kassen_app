rules_version = '2';

// Sicherheitsregeln der TSV KassenApp.
//
// Die Rolle stammt aus den Custom Claims des Auth-Tokens, nicht mehr aus
// users/{uid}.role. Das schliesst zwei Dinge aus: dass ein Nutzer sich selbst
// befoerdert (Claims kann nur das Backend setzen), und dass jede einzelne
// Regelauswertung ein zusaetzliches Dokument liest.
//
// Gesetzt werden die Claims in functions/admin_users.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- Grundlagen

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function isAdmin()   { return role() == 'admin'; }
    function isServer()  { return role() == 'server'; }
    function isKitchen() { return role() == 'kitchen'; }
    function isBar()     { return role() == 'bar'; }

    /// Nur die genannten Felder wurden veraendert.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------- Nutzer

    // Anzeigedaten und Push-Token darf jeder an seinem eigenen Dokument
    // pflegen. Rolle und Sperrstatus ausdruecklich nicht - die setzt allein das
    // Backend ueber das Admin-SDK, das an diesen Regeln vorbeischreibt.
    match /users/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && uid == request.auth.uid
        && request.resource.data.keys()
             .hasOnly(['uid', 'email', 'displayName', 'deviceTokens', 'lastToken', 'updatedAt']);

      allow update: if isSignedIn() && uid == request.auth.uid
        && onlyChanges(['displayName', 'deviceTokens', 'lastToken', 'updatedAt']);

      allow delete: if false;
    }

    // ------------------------------------------------------------ Stammdaten

    match /menu/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tables/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /events/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /orgs/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --------------------------------------------------------------- Tickets

    match /tickets/{ticketId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        (isServer() && request.resource.data.serverId == request.auth.uid) || isAdmin()
      );

      // Bezahlte Tickets sind unveraenderlich; der zustaendige Kellner darf
      // nicht wechseln; der Status muss einer der bekannten sein.
      allow update: if isSignedIn() && (isServer() || isAdmin())
        && resource.data.status != 'paid'
        && request.resource.data.serverId == resource.data.serverId
        && request.resource.data.status in ['open', 'sentToKitchen', 'ready', 'served', 'paid'];

      // Kueche und Bar melden "fertig". Dabei schreibt die App nicht nur die
      // Position, sondern auch routesReady und status auf dem Ticket - ohne
      // diese Regel scheitert das Abhaken, nachdem die Position bereits
      // umgestellt wurde, und der Bon bleibt in einem halben Zustand haengen.
      //
      // Bewusst eng gefasst: ausschliesslich diese drei Felder, der Kellner
      // bleibt unangetastet, und bezahlt wird hierueber nicht.
      allow update: if isSignedIn() && (isKitchen() || isBar())
        && resource.data.status != 'paid'
        && onlyChanges(['routesReady', 'updatedAt', 'status'])
        && request.resource.data.status in ['open', 'sentToKitchen', 'ready', 'served'];

      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if isSignedIn();

        // Positionen eines bereits abgerechneten Tickets bleiben unangetastet.
        // Vorher fehlte diese Pruefung: das Ticket war nach der Zahlung
        // gesperrt, seine Positionen aber weiterhin aenderbar.
        allow create, update, delete: if isSignedIn()
          && (isServer() || isAdmin())
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.status != 'paid';

        // Kueche und Bar duerfen Positionen auf 'ready' setzen - und sonst
        // nichts. Weder Preis noch Menge noch Route sind veraenderbar.
        //
        // Ohne Einschraenkung auf die eigene Route: sind Kueche und Bar
        // zusammengelegt (orgs.mergeKitchenBar), zeigt die Kuechenansicht
        // beide Routen, und die Trennung waere nur noch durchsetzbar, indem
        // jede Regelauswertung die Organisationseinstellung nachliest. Der
        // Preis dafuer waere ein zusaetzlicher Dokumentlesevorgang bei jedem
        // Abhaken, und verhindert wuerde damit eine Verwechslung im Betrieb,
        // kein Missbrauch: mehr als "fertig" kann hier niemand setzen.
        allow update: if isSignedIn() && (isKitchen() || isBar())
          && request.resource.data.status == 'ready'
          && resource.data.status in ['open', 'sentToKitchen']
          && onlyChanges(['status', 'updatedAt', 'readyAt']);
      }
    }

    // Sammelgruppen-Abfragen auf "items"
    //
    // Kueche, Bar und Tischplan fragen ueber collectionGroup('items') ab. Auf
    // solche Abfragen trifft die verschachtelte Regel unter tickets/{id}/items
    // NICHT zu - Firestore verlangt dafuer eine eigene Regel auf Gruppenebene.
    // Fehlt sie, liefert die Kuechenansicht permission-denied, obwohl der
    // Zugriff auf dieselben Dokumente ueber den vollen Pfad erlaubt ist.
    //
    // Nur Lesen. Geschrieben wird weiterhin ausschliesslich ueber den vollen
    // Pfad und damit unter den Regeln oben.
    match /{path=**}/items/{itemId} {
      allow read: if isSignedIn();
    }

    // -------------------------------------------------------------- Verkaeufe

    match /sales/{saleId} {
      // Einzelabruf: der Kellner braucht den gerade gebuchten Beleg, um ihn
      // zu drucken. Auflisten dagegen ist Auswertung und bleibt dem Admin
      // vorbehalten - sonst sieht jede Aushilfe alle Tagesumsaetze.
      allow get: if isSignedIn() && (isServer() || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() && (isServer() || isAdmin())
        && request.resource.data.paymentMethod in ['cash', 'card']
        && request.resource.data.totalCents is int
        && request.resource.data.totalCents >= 0
        && request.resource.data.day is string
        && request.resource.data.serverId is string;

      // Gebuchte Verkaeufe sind unveraenderlich.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- Geraete

    // Freigeschaltete Geraete fuer die passwortlose Personalanmeldung.
    //
    // Kein Schreibzugriff von der App: angelegt und widerrufen wird
    // ausschliesslich ueber die Cloud Functions, die am Admin-SDK vorbei an
    // diesen Regeln vorbeischreiben. Lesen darf nur der Admin - das
    // Geraetegeheimnis liegt zwar nur als Pruefsumme hier, aber die Liste der
    // Geraete geht sonst niemanden etwas an.
    match /devices/{deviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------ Kassentage

    // Kassenstart, Einlagen, Entnahmen. Nur Admin, weil die Kasse insgesamt
    // admin-only ist. Die Dokument-ID ist der Tag (yyyy-MM-dd).
    match /cashDays/{day} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.openingCents is int
        && request.resource.data.depositCents is int
        && request.resource.data.withdrawalCents is int
        && request.resource.data.openingCents >= 0
        && request.resource.data.depositCents >= 0
        && request.resource.data.withdrawalCents >= 0
        && request.resource.data.day == day;
      allow delete: if false;
    }
  }
}
